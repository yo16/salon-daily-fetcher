# Salon.JP 個人会員の認証情報。
# このファイルを .env.local にコピーして実値を入れる。
#   copy .env.local.example .env.local   (Windows)
# .env.local は .gitignore 済み。絶対にコミットしないこと。
SALON_EMAIL=
SALON_PASSWORD=

# n8n MCP（Cursor の .cursor/mcp.json から参照）
# ベース URL または MCP エンドポイント URL のどちらでも可
#   例: http://localhost:5678
#   例: https://your-n8n.example.com/mcp-server/http
N8N_MCP_URL=http://localhost:5678
N8N_MCP_TOKEN=
